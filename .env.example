# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database: "postgres" for Docker/PostgreSQL, "sqlite" for a quick local demo
DB_ENGINE=postgres
POSTGRES_DB=trackit
POSTGRES_USER=trackit_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Email OTP. Leave EMAIL_HOST_USER empty to print OTP email in the backend console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TRACK-IT <noreply@example.com>

# Redis / asynchronous jobs / WebSocket channel layer
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/notifications/
